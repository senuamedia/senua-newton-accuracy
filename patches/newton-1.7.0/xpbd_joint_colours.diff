+import os
 import warnings
 
 import warp as wp
 
+# Senua AI patch, in design: with NEWTON_XPBD_JOINT_COLOURS=1 (read once, here) the joint pass is a Gauss-Seidel
+# sweep over colours: the joints are coloured so that no two of one colour act on the same dynamic body, and each
+# colour is solved and its corrections applied before the next is solved, so every joint sees its neighbours' latest
+# poses (graph colouring, as in Fratarcangeli, Tibaldo and Pellacini 2016). As released every joint is solved from the
+# same state and two joints sharing a link each move it by its whole correction, which only under-relaxation keeps
+# stable.
+_JOINT_COLOURS = os.environ.get("NEWTON_XPBD_JOINT_COLOURS") == "1"
+
 from ...core.types import override
 from ...sim import Contacts, Control, Model, ModelFlags, State
