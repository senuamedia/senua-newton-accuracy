         self._init_kinematic_state()
 
+        # Senua AI patch, in design: the joint pass's colours, each an enabled mask over the joints; None leaves the
+        # pass as released (one launch over every joint)
+        self._joint_colour_masks = None
+        if _JOINT_COLOURS and model.joint_count > 0:
+            import numpy as np  # noqa: PLC0415
+
+            from ...sim import JointType  # noqa: PLC0415
+
+            parent = model.joint_parent.numpy()
+            child = model.joint_child.numpy()
+            enabled = model.joint_enabled.numpy()
+            jtype = model.joint_type.numpy()
+            inv_m = model.body_inv_mass.numpy() if model.body_count > 0 else np.zeros(0)
+            colour = np.full(model.joint_count, -1, dtype=np.int64)
+            body_colours = [set() for _ in range(model.body_count)]
+            for j in range(model.joint_count):
+                if not enabled[j] or jtype[j] == int(JointType.FREE):
+                    continue
+                bodies = [bd for bd in (parent[j], child[j]) if bd >= 0 and inv_m[bd] > 0.0]
+                c = 0
+                while any(c in body_colours[bd] for bd in bodies):
+                    c += 1
+                colour[j] = c
+                for bd in bodies:
+                    body_colours[bd].add(c)
+            ncol = int(colour.max()) + 1 if (colour >= 0).any() else 0
+            if ncol > 0:
+                self._joint_colour_masks = [
+                    wp.array(enabled & (colour == c), dtype=bool, device=model.device) for c in range(ncol)
+                ]
+
         # helper variables to track constraint resolution vars
