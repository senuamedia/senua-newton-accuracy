@@ -0,0 +1,282 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 The Newton Developers
+# SPDX-License-Identifier: Apache-2.0
+#
+# Senua AI patch, in design: Featherstone's contact friction as Coulomb's law at the step's end.
+#
+# Featherstone's contact pass is SemiImplicit's (semi_implicit/kernels_contact.py, eval_body_contact), its friction a
+# force integrated explicitly: below mu N / kf it is viscous, so a load inside the friction limit creeps (issue 6), and
+# its kf settles only for steps under about 1.25 m / (10 kf) (issue 9). Here, as in SemiImplicit's Coulomb friction
+# patch (semi_implicit/kernels_contact_coulomb.py), the friction is taken out of the force pass and, after the step's
+# integration, each contact is given the tangential impulse that stops its slip, shared among its body's contacts, its
+# total over the step within mu times the normal impulse the force pass applied there, the pass made K times a step.
+# A body's impulses act on the joints as its forces do in eval_rigid_tau: each body's impulse wrench, taken about its
+# solve origin and summed over the bodies beyond each joint, projected on the joint's motion subspace; the change of
+# the joints' speeds solves the step's own joint-space inertia (its Cholesky factor, as for the accelerations), and the
+# joints' coordinates follow that change over the step, as the semi-implicit position update does. Launched only when
+# the solver is made with NEWTON_FEATHERSTONE_COULOMB_FRICTION=K (an integer, the sweeps a step; read once) and the
+# model has no joint mimics; otherwise never imported.
+#
+# Third form: the joint-space inertia the impulses are solved with is built where the step leaves the joints
+# (Featherstone's own kernels: forward kinematics, the motion subspaces and spatial inertias, the Jacobian, the
+# mass matrix, H = J^T M J and its Cholesky factor, at the integrated coordinates), as SemiImplicit's pass takes
+# each body's inertia as the step leaves it; the first form used the step's start, which gave a body turning or
+# moving over the step a friction impulse off the one solved, first order in the step (runs 094, 097).
+
+import warp as wp
+
+from ...sim import Contacts, Model, State
+from ..semi_implicit.kernels_contact_coulomb import (
+    CoulombFrictionArrays,
+    eval_body_contact_coulomb,
+    solve_contact_friction_accumulated,
+)
+from .kernels import (
+    eval_dense_cholesky_batched,
+    eval_dense_gemm_batched,
+    eval_dense_solve_batched,
+    eval_fk_with_velocity_conversion,
+    eval_rigid_fk,
+    eval_rigid_id,
+    eval_rigid_jacobian,
+    eval_rigid_mass,
+    integrate_generalized_joints,
+)
+
+
+@wp.kernel
+def eval_impulse_tau(
+    articulation_start: wp.array[int],
+    articulation_end: wp.array[int],
+    joint_parent: wp.array[int],
+    joint_child: wp.array[int],
+    joint_qd_start: wp.array[int],
+    joint_S_s: wp.array[wp.spatial_vector],
+    body_q_com: wp.array[wp.transform],
+    body_solve_origin: wp.array[wp.vec3],
+    body_dp: wp.array[wp.spatial_vector],
+    # outputs
+    body_acc_s: wp.array[wp.spatial_vector],
+    tau: wp.array[float],
+):
+    # one thread per articulation, its joints from the leaves back, as eval_rigid_tau
+    index = wp.tid()
+    start = articulation_start[index]
+    end = articulation_end[index]
+    for offset in range(end - start):
+        i = end - offset - 1
+        parent = joint_parent[i]
+        child = joint_child[i]
+        dp = body_dp[child]
+        impulse = wp.spatial_top(dp)
+        x_com_s = wp.transform_get_translation(body_q_com[child]) - body_solve_origin[child]
+        w_s = body_acc_s[child] + wp.spatial_vector(impulse, wp.spatial_bottom(dp) + wp.cross(x_com_s, impulse))
+        for dof in range(joint_qd_start[i], joint_qd_start[i + 1]):
+            tau[dof] = wp.dot(joint_S_s[dof], w_s)
+        if parent >= 0:
+            body_acc_s[parent] = body_acc_s[parent] + w_s
+
+
+@wp.kernel
+def add_joint_qd(joint_qd: wp.array[float], dqd: wp.array[float]):
+    i = wp.tid()
+    joint_qd[i] = joint_qd[i] + dqd[i]
+
+
+class FeatherstoneCoulombFriction:
+    """The pass's records and scratch, sized from the model and its contacts."""
+
+    def __init__(self, model: Model, contacts: Contacts):
+        self.records = CoulombFrictionArrays(model, contacts)
+        n = model.joint_dof_count
+        with wp.ScopedDevice(model.device):
+            self.pt = wp.zeros(contacts.rigid_contact_max, dtype=wp.vec3)
+            self.acc = wp.zeros(model.body_count, dtype=wp.spatial_vector)
+            self.tau = wp.zeros(n, dtype=float)
+            self.dqd = wp.zeros(n, dtype=float)
+            self.tmp = wp.zeros(n, dtype=float)
+            self.zero_qdd = wp.zeros(n, dtype=float)
+            self.qd_scratch = wp.zeros(n, dtype=float)
+            self.q_scratch = wp.zeros(model.joint_coord_count, dtype=float)
+        self.end = None  # the step's end: its poses, subspaces, inertias and joint-space matrices, made at first use
+
+
+def force_pass(
+    model: Model, body_q, body_qd, contacts: Contacts, pass_arrays: FeatherstoneCoulombFriction, friction_smoothing, body_f
+):
+    """The stock contact pass's launch, its friction left out and each contact recorded."""
+    arrays = pass_arrays.records
+    arrays.clear()
+    wp.launch(
+        kernel=eval_body_contact_coulomb,
+        dim=contacts.rigid_contact_max,
+        inputs=[
+            body_q,
+            body_qd,
+            model.body_com,
+            model.shape_material_ke,
+            model.shape_material_kd,
+            model.shape_material_kf,
+            model.shape_material_ka,
+            model.shape_material_mu,
+            model.shape_body,
+            contacts.rigid_contact_count,
+            contacts.rigid_contact_point0,
+            contacts.rigid_contact_point1,
+            contacts.rigid_contact_surface_velocity,
+            contacts.rigid_contact_normal,
+            contacts.rigid_contact_shape0,
+            contacts.rigid_contact_shape1,
+            contacts.rigid_contact_margin0,
+            contacts.rigid_contact_margin1,
+            contacts.rigid_contact_stiffness,
+            contacts.rigid_contact_damping,
+            contacts.rigid_contact_friction,
+            False,
+            friction_smoothing,
+        ],
+        outputs=[body_f, arrays.fn, arrays.nrm, arrays.ra, arrays.rb, arrays.mu, arrays.bodies, arrays.count],
+        device=model.device,
+    )
+
+
+class _EndInertia:
+    def __init__(self, solver, state_out: State, state_aug):
+        self.body_q = wp.zeros_like(state_out.body_q)
+        self.body_q_com = wp.zeros_like(state_aug.body_q_com)
+        self.body_qd = wp.zeros_like(state_aug.body_qd_fk)
+        self.joint_S_s = wp.zeros_like(state_aug.joint_S_s)
+        self.body_solve_origin = wp.zeros_like(state_aug.body_solve_origin)
+        self.body_I_s = wp.zeros_like(state_aug.body_I_s)
+        self.body_v_s = wp.zeros_like(state_aug.body_v_s)
+        self.body_f_s = wp.zeros_like(state_aug.body_f_s)
+        self.body_a_s = wp.zeros_like(state_aug.body_a_s)
+        self.J = wp.zeros_like(solver.J)
+        self.M = wp.zeros_like(solver.M)
+        self.P = wp.zeros_like(solver.J)
+        self.H = wp.zeros_like(solver.H)
+        self.L = wp.zeros_like(solver.H)
+
+
+def inertia_at_end(solver, model: Model, state_out: State, state_aug, end: _EndInertia):
+    """The joint-space inertia and its factor where the step leaves the joints, by Featherstone's own kernels."""
+    n = model.articulation_count
+    wp.launch(eval_rigid_fk, dim=n, inputs=[model.articulation_start, model.articulation_end, model.joint_type,
+              model.joint_parent, model.joint_child, model.joint_q_start, model.joint_qd_start, state_out.joint_q,
+              model.joint_X_p, model.joint_X_c, solver.body_X_com, model.joint_axis, model.joint_dof_dim],
+              outputs=[end.body_q, end.body_q_com], device=model.device)
+    end.body_f_s.zero_()
+    wp.launch(eval_rigid_id, dim=n, inputs=[None, model.articulation_start, model.articulation_end, model.joint_type,
+              model.joint_parent, model.joint_child, model.joint_q_start, model.joint_qd_start, state_out.joint_q,
+              state_aug.joint_qd_internal_out, model.joint_axis, model.joint_dof_dim, solver.body_I_m, end.body_q,
+              end.body_q_com, model.joint_X_p, model.body_world, model.gravity],
+              outputs=[end.body_qd, end.joint_S_s, end.body_solve_origin, end.body_I_s, end.body_v_s, end.body_f_s,
+                       end.body_a_s], device=model.device)
+    wp.launch(eval_rigid_jacobian, dim=n, inputs=[model.articulation_start, model.articulation_end,
+              solver.articulation_J_start, model.joint_ancestor, model.joint_qd_start, end.joint_S_s],
+              outputs=[end.J], device=model.device)
+    wp.launch(eval_rigid_mass, dim=n, inputs=[model.articulation_start, model.articulation_end,
+              solver.articulation_M_start, end.body_I_s], outputs=[end.M], device=model.device)
+    wp.launch(eval_dense_gemm_batched, dim=n, inputs=[solver.articulation_M_rows, solver.articulation_J_cols,
+              solver.articulation_J_rows, False, False, solver.articulation_M_start, solver.articulation_J_start,
+              solver.articulation_J_start, end.M, end.J], outputs=[end.P], device=model.device)
+    wp.launch(eval_dense_gemm_batched, dim=n, inputs=[solver.articulation_J_cols, solver.articulation_J_cols,
+              solver.articulation_J_rows, True, False, solver.articulation_J_start, solver.articulation_J_start,
+              solver.articulation_H_start, end.J, end.P], outputs=[end.H], device=model.device)
+    wp.launch(eval_dense_cholesky_batched, dim=n, inputs=[solver.articulation_H_start, solver.articulation_H_rows,
+              solver.articulation_dof_start, end.H, solver.joint_armature_effective], outputs=[end.L],
+              device=model.device)
+
+
+def friction_sweeps(solver, model: Model, state_out: State, state_aug, contacts: Contacts, pass_arrays, dt: float):
+    """The friction pass made `solver._coulomb_sweeps` times, after the step's integration and before its forward
+    kinematics; each sweep from the joints' speeds the one before left."""
+    arrays = pass_arrays.records
+    pass_arrays.pt.zero_()
+    if pass_arrays.end is None:
+        pass_arrays.end = _EndInertia(solver, state_out, state_aug)
+    end = pass_arrays.end
+    inertia_at_end(solver, model, state_out, state_aug, end)
+    qd = state_aug.joint_qd_internal_out
+    for _ in range(solver._coulomb_sweeps):
+        eval_fk_with_velocity_conversion(model, state_out.joint_q, qd, state_out)
+        arrays.dp.zero_()
+        wp.launch(
+            kernel=solve_contact_friction_accumulated,
+            dim=contacts.rigid_contact_max,
+            inputs=[
+                state_out.body_q,
+                state_out.body_qd,
+                model.body_com,
+                model.body_inv_mass,
+                model.body_inv_inertia,
+                contacts.rigid_contact_count,
+                arrays.fn,
+                arrays.nrm,
+                arrays.ra,
+                arrays.rb,
+                arrays.mu,
+                arrays.bodies,
+                arrays.count,
+                dt,
+                pass_arrays.pt,
+            ],
+            outputs=[arrays.dp],
+            device=model.device,
+        )
+        pass_arrays.acc.zero_()
+        pass_arrays.tau.zero_()
+        wp.launch(
+            kernel=eval_impulse_tau,
+            dim=model.articulation_count,
+            inputs=[
+                model.articulation_start,
+                model.articulation_end,
+                model.joint_parent,
+                model.joint_child,
+                model.joint_qd_start,
+                end.joint_S_s,
+                end.body_q_com,
+                end.body_solve_origin,
+                arrays.dp,
+            ],
+            outputs=[pass_arrays.acc, pass_arrays.tau],
+            device=model.device,
+        )
+        pass_arrays.dqd.zero_()
+        wp.launch(
+            eval_dense_solve_batched,
+            dim=model.articulation_count,
+            inputs=[
+                solver.articulation_H_start,
+                solver.articulation_H_rows,
+                solver.articulation_dof_start,
+                end.H,
+                end.L,
+                pass_arrays.tau,
+            ],
+            outputs=[pass_arrays.dqd, pass_arrays.tmp],
+            device=model.device,
+        )
+        wp.launch(add_joint_qd, dim=model.joint_dof_count, inputs=[qd, pass_arrays.dqd], device=model.device)
+        # the joints' coordinates follow the change of their speeds over the step
+        wp.copy(pass_arrays.q_scratch, state_out.joint_q)
+        wp.launch(
+            kernel=integrate_generalized_joints,
+            dim=model.joint_count,
+            inputs=[
+                model.joint_type,
+                model.joint_parent,
+                model.joint_child,
+                model.joint_q_start,
+                model.joint_qd_start,
+                model.joint_dof_dim,
+                model.joint_X_c,
+                model.body_com,
+                pass_arrays.q_scratch,
+                pass_arrays.dqd,
+                pass_arrays.zero_qdd,
+                dt,
+            ],
+            outputs=[state_out.joint_q, pass_arrays.qd_scratch],
+            device=model.device,
+        )
