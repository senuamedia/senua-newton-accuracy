+@wp.kernel
+def solve_contact_speculative_normal(
+    body_q: wp.array[wp.transform],
+    body_qd: wp.array[wp.spatial_vector],
+    body_inv_mass: wp.array[float],
+    body_inv_inertia: wp.array[wp.mat33],
+    contact_count: wp.array[int],
+    contact_sep: wp.array[float],
+    contact_nrm: wp.array[wp.vec3],
+    contact_ra: wp.array[wp.vec3],
+    contact_rb: wp.array[wp.vec3],
+    contact_bodies: wp.array[wp.vec2i],
+    body_spec_count: wp.array[int],
+    dt: float,
+    # the normal impulse each contact has applied so far this step
+    contact_pn: wp.array[float],
+    # output: this sweep's impulse on each body, linear and angular, world frame
+    body_dp: wp.array[wp.spatial_vector],
+):
+    """Senua AI patch, in design: the normal impulse that keeps a contact still apart at the step's start apart at its
+    end, its closing speed cut to d / dt, shared among the body's such contacts, its total never pulling."""
+    tid = wp.tid()
+    if tid >= contact_count[0]:
+        return
+    sep = contact_sep[tid]
+    if sep < 0.0:
+        return
+    body_a = contact_bodies[tid][0]
+    body_b = contact_bodies[tid][1]
+    n = contact_nrm[tid]
+    r_a = contact_ra[tid]
+    r_b = contact_rb[tid]
+    v = wp.vec3(0.0)
+    w_eff = 0.0
+    shared = 1
+    if body_a >= 0:
+        qd = body_qd[body_a]
+        v += wp.spatial_top(qd) + wp.cross(wp.spatial_bottom(qd), r_a)
+        shared = wp.max(shared, body_spec_count[body_a])
+        rot = wp.quat_to_matrix(wp.transform_get_rotation(body_q[body_a]))
+        inv_I = rot * body_inv_inertia[body_a] * wp.transpose(rot)
+        rn = wp.cross(r_a, n)
+        w_eff += body_inv_mass[body_a] + wp.dot(rn, inv_I * rn)
+    if body_b >= 0:
+        qd = body_qd[body_b]
+        v -= wp.spatial_top(qd) + wp.cross(wp.spatial_bottom(qd), r_b)
+        shared = wp.max(shared, body_spec_count[body_b])
+        rot = wp.quat_to_matrix(wp.transform_get_rotation(body_q[body_b]))
+        inv_I = rot * body_inv_inertia[body_b] * wp.transpose(rot)
+        rn = wp.cross(r_b, n)
+        w_eff += body_inv_mass[body_b] + wp.dot(rn, inv_I * rn)
+    if w_eff <= 0.0:
+        return
+    # the separation changes at n . (v_a - v_b); apart at the step's end while that is no less than -sep / dt
+    j = (-sep / dt - wp.dot(n, v)) / (w_eff * float(shared))
+    old = contact_pn[tid]
+    new = wp.max(old + j, 0.0)
+    contact_pn[tid] = new
+    p = n * (new - old)
+    if body_a >= 0:
+        wp.atomic_add(body_dp, body_a, wp.spatial_vector(p, wp.cross(r_a, p)))
+    if body_b >= 0:
+        wp.atomic_sub(body_dp, body_b, wp.spatial_vector(p, wp.cross(r_b, p)))
+
+
+def speculative_normal_sweep(model: Model, state: State, contacts: Contacts, arrays: CoulombFrictionArrays, dt: float):
+    """Senua AI patch, in design: one sweep of the speculative normal, its impulses added to the pass's body impulses."""
+    wp.launch(
+        kernel=solve_contact_speculative_normal,
+        dim=contacts.rigid_contact_max,
+        inputs=[
+            state.body_q,
+            state.body_qd,
+            model.body_inv_mass,
+            model.body_inv_inertia,
+            contacts.rigid_contact_count,
+            arrays.sep,
+            arrays.nrm,
+            arrays.ra,
+            arrays.rb,
+            arrays.bodies,
+            arrays.spec_count,
+            dt,
+            arrays.pn,
+        ],
+        outputs=[arrays.dp],
+        device=model.device,
+    )
