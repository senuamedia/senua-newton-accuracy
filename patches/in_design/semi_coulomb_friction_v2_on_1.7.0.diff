+        w_eff += body_inv_mass[body_b] + wp.dot(rt, inv_I * rt)
+    if w_eff <= 0.0:
+        return
+    # this sweep's impulse added to the contact's total over the step, the total kept within Coulomb's cone
+    # (accumulated impulses, Catto, Iterative dynamics with temporal coherence, 2005)
+    total_before = contact_pt[tid]
+    total = total_before - vt / (w_eff * float(shared))
+    cap = contact_mu[tid] * fn * dt
+    size = wp.length(total)
+    if size > cap:
+        total = total * (cap / size)
+    contact_pt[tid] = total
+    p = total - total_before
+    if body_a >= 0:
+        wp.atomic_add(body_dp, body_a, wp.spatial_vector(p, wp.cross(r_a, p)))
+    if body_b >= 0:
+        wp.atomic_sub(body_dp, body_b, wp.spatial_vector(p, wp.cross(r_b, p)))
+
+
+def friction_pass_iterated(
+    model: Model, state: State, contacts: Contacts, arrays: CoulombFrictionArrays, dt: float, iterations: int
+):
+    """The friction pass made `iterations` times, each sweep from the velocities the one before left, every contact's
+    friction over the step kept within Coulomb's cone on its total."""
+    pt = getattr(arrays, "pt", None)
+    if pt is None or pt.shape[0] != arrays.fn.shape[0]:
+        pt = wp.zeros(arrays.fn.shape[0], dtype=wp.vec3, device=model.device)
+        arrays.pt = pt
+    pt.zero_()
+    for _ in range(iterations):
+        arrays.dp.zero_()
+        wp.launch(
+            kernel=solve_contact_friction_accumulated,
+            dim=contacts.rigid_contact_max,
+            inputs=[
+                state.body_q,
+                state.body_qd,
+                model.body_com,
+                model.body_inv_mass,
+                model.body_inv_inertia,
+                contacts.rigid_contact_count,
+                arrays.fn,
+                arrays.nrm,
+                arrays.ra,
+                arrays.rb,
+                arrays.mu,
+                arrays.bodies,
+                arrays.count,
+                dt,
+                pt,
+            ],
+            outputs=[arrays.dp],
+            device=model.device,
+        )
+        wp.launch(
+            kernel=apply_contact_friction,
+            dim=model.body_count,
+            inputs=[state.body_q, state.body_qd, model.body_com, model.body_inv_mass, model.body_inv_inertia, arrays.dp, dt],
+            device=model.device,
+        )
