--- a/newton/_src/solvers/friction_combine.py
+++ b/newton/_src/solvers/friction_combine.py
@@ -0,0 +1,47 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 The Newton Developers
+# SPDX-License-Identifier: Apache-2.0
+#
+# Senua AI patch, in design: one friction combination for every solver.
+#
+# Two shapes in contact each carry a friction coefficient, and Newton's solvers combine them differently: XPBD,
+# SemiImplicit and Featherstone take their mean, VBD their geometric mean, and the MuJoCo solver MuJoCo's rule, the
+# larger of the two, or the higher-priority geom's when the MuJoCo solver's custom attributes give the two shapes
+# different priorities (mujoco:geom_priority) (run 059 of the Senua AI deep dive: one scene slides 92.5 mm on XPBD and
+# 56.9 mm on the MuJoCo solver). The MuJoCo solver can follow no other rule: MuJoCo combines a contact's friction
+# itself, with its own contacts and with Newton's. With NEWTON_FRICTION_COMBINE=1 (read once, here) Newton's own
+# solvers follow MuJoCo's rule for body contacts too: the larger coefficient (sliding, torsional and rolling each), or
+# the higher-priority shape's when the model carries MuJoCo's geom priority and the two differ. Unset, nothing changes.
+
+import os
+
+import warp as wp
+
+FRICTION_COMBINE = wp.constant(os.environ.get("NEWTON_FRICTION_COMBINE") == "1")
+
+_EMPTY = {}
+
+
+def shape_priority(model) -> wp.array:
+    """The model's MuJoCo geom priority, per shape, when the switch is set and the model carries it; else empty."""
+    if FRICTION_COMBINE:
+        ns = getattr(model, "mujoco", None)
+        prio = getattr(ns, "geom_priority", None) if ns is not None else None
+        if prio is not None:
+            return prio
+    key = str(model.device)
+    if key not in _EMPTY:
+        _EMPTY[key] = wp.zeros(0, dtype=int, device=model.device)
+    return _EMPTY[key]
+
+
+@wp.func
+def combine_mu(mu_a: float, mu_b: float, priority: wp.array[int], shape_a: int, shape_b: int) -> float:
+    """MuJoCo's rule: the higher-priority shape's coefficient when the priorities differ, else the larger."""
+    if priority.shape[0] > 0:
+        pa = priority[shape_a]
+        pb = priority[shape_b]
+        if pa > pb:
+            return mu_a
+        if pb > pa:
+            return mu_b
+    return wp.max(mu_a, mu_b)
