@@ -0,0 +1,33 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 The Newton Developers
+# SPDX-License-Identifier: Apache-2.0
+#
+# Senua AI patch, in design: a solver that does not apply a shape's static friction coefficient says so.
+#
+# Pull request #4306 adds a static (break-away) coefficient to Newton's shapes, `mu_static`, which a solver uses as
+# max(mu_static, mu); with NEWTON_STATIC_FRICTION=1 (read once, here) XPBD sticks within it. MuJoCo models one
+# coefficient, so the MuJoCo solver cannot: when made, it warns once, naming the shapes whose static coefficient is
+# above their dynamic one. Nothing a solver does changes.
+
+import os
+import warnings
+
+import numpy as np
+
+STATIC_FRICTION = os.environ.get("NEWTON_STATIC_FRICTION") == "1"
+
+
+def warn_static_friction_not_applied(model, solver_name: str):
+    if not STATIC_FRICTION or getattr(model, "shape_material_mu_static", None) is None or model.shape_count == 0:
+        return
+    mus = model.shape_material_mu_static.numpy()
+    mu = model.shape_material_mu.numpy()
+    shapes = [i for i in range(len(mus)) if mus[i] >= 0.0 and mus[i] > mu[i]]
+    if shapes:
+        labels = list(model.shape_label) if getattr(model, "shape_label", None) is not None else []
+        shown = [labels[i] if i < len(labels) and labels[i] else str(i) for i in shapes[:8]]
+        more = " and %d more" % (len(shapes) - 8) if len(shapes) > 8 else ""
+        warnings.warn(
+            "%s does not apply a static friction coefficient (MuJoCo models one): shapes %s%s play at their dynamic"
+            " coefficient." % (solver_name, ", ".join(shown), more),
+            stacklevel=3,
+        )
