+# Senua AI patch, in design: with NEWTON_XPBD_FRICTION_SLIP=1 (read once, here) the friction above measures a step's
+# slip as the two contact points' separation at the step's start plus each point's motion over the step, carried per
+# body (the integrator's v dt and w dt, and every correction since), not as the difference of the two points' 32-bit
+# world positions now, which cannot see a slip under one spacing of those coordinates: a body held by friction
+# slips by about that spacing a step, unseen (Study 27: 12 um/s at 0.25 ms, 3.7 nm a step at 0.04 m from the
+# origin).
+FRICTION_SLIP = os.environ.get("NEWTON_XPBD_FRICTION_SLIP") == "1"
+
+
+@wp.func
+def _turn_of(th: wp.vec3, w: wp.vec3) -> wp.vec3:
+    """How far a lever w moves under a turn th (its rotation vector): Rodrigues' formula, its two factors by series."""
+    t2 = wp.dot(th, th)
+    a = 1.0 - t2 / 6.0 + t2 * t2 / 120.0
+    b = 0.5 - t2 / 24.0 + t2 * t2 / 720.0
+    c = wp.cross(th, w)
+    return a * c + b * wp.cross(th, c)
+
+
+@wp.func
+def _carried_motion(body: int, X0: wp.transform, com: wp.vec3, p0: wp.vec3, step_dp: wp.array[wp.vec3],
+                    step_dth: wp.array[wp.vec3]) -> wp.vec3:
+    """A body point's motion over the step, from the body's carried motion: the centre's, and the turn on the lever."""
+    if body < 0:
+        return wp.vec3(0.0)
+    return step_dp[body] + _turn_of(step_dth[body], p0 - wp.transform_point(X0, com))
+
+
+@wp.kernel
+def start_carried_motion(body_qd: wp.array[wp.spatial_vector], body_inv_m: wp.array[float], dt: float,
+                         step_dp: wp.array[wp.vec3], step_dth: wp.array[wp.vec3]):
+    """The integrator's motion over the step: x1 = x0 + v1 dt, the turn w1 dt."""
+    tid = wp.tid()
+    if body_inv_m[tid] == 0.0:
+        step_dp[tid] = wp.vec3(0.0)
+        step_dth[tid] = wp.vec3(0.0)
+        return
+    step_dp[tid] = wp.spatial_top(body_qd[tid]) * dt
+    step_dth[tid] = wp.spatial_bottom(body_qd[tid]) * dt
+
+
+@wp.kernel
+def carry_body_deltas(
+    q_in: wp.array[wp.transform],
+    qd_in: wp.array[wp.spatial_vector],
+    body_I: wp.array[wp.mat33],
+    body_inv_m: wp.array[float],
+    body_inv_I: wp.array[wp.mat33],
+    deltas: wp.array[wp.spatial_vector],
+    constraint_inv_weights: wp.array[float],
+    dt: float,
+    step_dp: wp.array[wp.vec3],
+    step_dth: wp.array[wp.vec3],
+):
+    """The correction apply_body_deltas makes to the centre (dp dt) and the turn (dw1 dt), its arithmetic, added on."""
+    tid = wp.tid()
+    inv_m = body_inv_m[tid]
+    if inv_m == 0.0:
+        return
+    inv_I = body_inv_I[tid]
+    delta = deltas[tid]
+    q0 = wp.transform_get_rotation(q_in[tid])
+    w0 = wp.spatial_bottom(qd_in[tid])
+    weight = 1.0
+    if constraint_inv_weights:
+        inv_weight = constraint_inv_weights[tid]
+        if inv_weight > 0.0:
+            weight = 1.0 / inv_weight
+    dp = wp.spatial_top(delta) * (inv_m * weight)
+    dq = wp.spatial_bottom(delta) * weight
+    wb = wp.quat_rotate_inv(q0, w0)
+    dwb = inv_I * wp.quat_rotate_inv(q0, dq)
+    tb = wp.cross(dwb, body_I[tid] * (wb + dwb)) + wp.cross(wb, body_I[tid] * dwb)
+    dw1 = wp.quat_rotate(q0, dwb - dt * inv_I * tb)
+    step_dp[tid] = step_dp[tid] + dp * dt
+    step_dth[tid] = step_dth[tid] + dw1 * dt
+
 
