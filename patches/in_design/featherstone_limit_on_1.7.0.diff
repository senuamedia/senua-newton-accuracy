--- a/newton/_src/solvers/featherstone/limit_kernels.py
+++ b/newton/_src/solvers/featherstone/limit_kernels.py
@@ -0,0 +1,81 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 The Newton Developers
+# SPDX-License-Identifier: Apache-2.0
+#
+# Senua AI patch, in design: Featherstone's joint limit kept from pulling, and integrated implicitly.
+#
+# Newton's joint limit (joint_force, semi_implicit/kernels_body.py) is a spring limit_ke (limit - q) and a damper
+# -limit_kd qd, applied whenever the joint is past its limit, evaluated at the step's start. Two departures follow
+# (findings F16, F20):
+# - It pulls: the damper acts until the angle is back at the limit, so it draws the joint back as it leaves (runs 036,
+#   042). A limit is one-sided: its force may push the joint out, never pull it in (Schwager and Poeschel 2007, the
+#   no-tension spring-dashpot, as Study 3 and Study 6 held contacts and the MuJoCo solver's limit to).
+# - It is explicit: Featherstone integrates it by semi-implicit Euler, stable only while w^2 h^2 + 2 g h < 4
+#   (w^2 = ke / I, g = kd / I), microseconds on light links (run 055).
+# Here the limit force is computed after the stock joint forces (which are given the limit's stiffness and damping as
+# zero, so their drive is still turned off past a limit, as before) and added to tau:
+# - NEWTON_FEATHERSTONE_LIMIT=1: the same spring and damper, explicit, never pulling (0 where it would);
+# - NEWTON_FEATHERSTONE_LIMIT=2: also linearly implicit (backward Euler for the spring and damper, Baraff and Witkin,
+#   Large steps in cloth simulation, SIGGRAPH 1998, section 4): with q' = q + h qd' and qd' = qd + h qdd,
+#   (H + h kd + h^2 ke) qdd = tau + ke (limit - q - h qd) - kd qd, so the spring is read at the predicted position and
+#   h kd + h^2 ke is added to the joint's diagonal of the joint-space inertia before its Cholesky factorization (as an
+#   armature is). Unconditionally stable for the spring and damper; where the implicit force would pull, the limit is
+#   left out of that step (force and diagonal 0).
+# Read once, when the solver is made; otherwise never imported.
+
+import warp as wp
+
+from ...sim import JointType
+
+
+@wp.kernel
+def eval_limit_forces(
+    joint_type: wp.array[int],
+    joint_q_start: wp.array[int],
+    joint_qd_start: wp.array[int],
+    joint_dof_dim: wp.array2d[int],
+    joint_q: wp.array[float],
+    joint_qd: wp.array[float],
+    joint_limit_lower: wp.array[float],
+    joint_limit_upper: wp.array[float],
+    joint_limit_ke: wp.array[float],
+    joint_limit_kd: wp.array[float],
+    dt: float,
+    implicit: int,
+    # outputs: tau gains the limit force; armature (a copy of the joint armature) gains the implicit diagonal
+    tau: wp.array[float],
+    armature: wp.array[float],
+):
+    i = wp.tid()
+    type = joint_type[i]
+    if type != JointType.PRISMATIC and type != JointType.REVOLUTE and type != JointType.D6:
+        return
+    dof_start = joint_qd_start[i]
+    coord_start = joint_q_start[i]
+    axis_count = joint_dof_dim[i, 0] + joint_dof_dim[i, 1]
+    for k in range(axis_count):
+        j = dof_start + k
+        q = joint_q[coord_start + k]
+        qd = joint_qd[j]
+        lower = joint_limit_lower[j]
+        upper = joint_limit_upper[j]
+        ke = joint_limit_ke[j]
+        kd = joint_limit_kd[j]
+        f = 0.0
+        d = 0.0
+        if q < lower or q > upper:
+            limit = lower
+            if q > upper:
+                limit = upper
+            x = limit - q
+            if implicit == 1:
+                x = x - dt * qd
+            f = ke * x - kd * qd
+            # one-sided: the force pushes the joint back inside its range, never pulls it
+            if q < lower and f < 0.0:
+                f = 0.0
+            if q > upper and f > 0.0:
+                f = 0.0
+            if implicit == 1 and f != 0.0:
+                d = dt * kd + dt * dt * ke
+        tau[j] = tau[j] + f
+        armature[j] = armature[j] + d
