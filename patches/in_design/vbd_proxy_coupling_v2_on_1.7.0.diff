+    body_com: wp.array[wp.vec3],
+    friction_epsilon: float,
+    rigid_body_particle_contact_use_log_barrier: bool,
+    body_particle_contact_penalty_k: wp.array[float],
+    body_particle_contact_material_kd: wp.array[float],
+    body_particle_contact_material_mu: wp.array[float],
+    body_particle_contact_count: wp.array[int],
+    body_particle_contact_max: int,
+    soft_contact_indices: wp.array[wp.vec3i],
+    soft_contact_barycentric: wp.array[wp.vec3],
+    body_particle_contact_shape: wp.array[int],
+    body_particle_contact_body_pos: wp.array[wp.vec3],
+    body_particle_contact_body_vel: wp.array[wp.vec3],
+    body_particle_contact_normal: wp.array[wp.vec3],
+    shape_margin: wp.array[float],
+    shape_body: wp.array[wp.int32],
+    particle_component: wp.array[wp.int32],
+    component_residual: wp.array[wp.vec3],
+    component_contact_magnitude: wp.array[float],
+    component_contact_candidates: wp.array[float],
+    out_body_f: wp.array[wp.spatial_vector],
+):
+    """Add each soft contact's reaction, as its particles received it, to its body's: every contact the particle side
+    applied, as the particle iteration walks them, so a contact the body's own list does not yet hold is not lost."""
+    contact_idx = wp.tid()
+    if contact_idx >= wp.min(body_particle_contact_max, body_particle_contact_count[0]):
+        return
+    corners = soft_contact_indices[contact_idx]
+    if corners[0] < 0 or corners[0] >= particle_q.shape[0]:
+        return
+    body_idx = shape_body[body_particle_contact_shape[contact_idx]]
+    if body_idx < 0 or body_idx >= out_body_f.shape[0]:
+        return
+    bary = soft_contact_barycentric[contact_idx]
+    force_on_particle, _hess, cp_world = _eval_soft_ef_contact(
+        contact_idx,
+        corners,
+        bary,
+        particle_q,
+        particle_q_prev,
+        particle_radius,
+        body_particle_contact_penalty_k[contact_idx],
+        body_particle_contact_material_kd[contact_idx],
+        body_particle_contact_material_mu[contact_idx],
+        friction_epsilon,
+        shape_body,
+        body_q,
+        body_q_prev,
+        body_qd,
+        body_com,
+        body_particle_contact_shape,
+        body_particle_contact_body_pos,
+        body_particle_contact_body_vel,
+        body_particle_contact_normal,
+        shape_margin,
+        dt,
+        rigid_body_particle_contact_use_log_barrier,
+    )
+    # less its deformable's unbalanced force, in the share this contact's force along it has of all its contacts'
+    realized = force_on_particle
+    for k in range(3):
+        j = corners[k]
+        if j >= 0:
+            c = particle_component[j]
+            total = component_contact_magnitude[c]
+            if total > 0.0:
+                g = component_residual[c]
+                realized = realized - g * (wp.abs(bary[k]) * wp.dot(force_on_particle, g) / total)
+            else:
+                # no contact force at the iterate along it (an impact the iterations pushed clear): its
+                # contact candidates share it alike
+                count = component_contact_candidates[c]
+                if count > 0.0:
+                    realized = realized - component_residual[c] * (wp.abs(bary[k]) / count)
+    force_on_body = -realized
+    com_world = wp.transform_point(body_q[body_idx], body_com[body_idx])
+    wp.atomic_add(out_body_f, body_idx, wp.spatial_vector(force_on_body, wp.cross(cp_world - com_world, force_on_body)))
+
+
+@wp.kernel(enable_backward=False)
+def _vbd_component_residual_kernel(
+    particle_component: wp.array[wp.int32],
+    particle_residual: wp.array[wp.vec3],
+    out_component_residual: wp.array[wp.vec3],
+):
+    """Sum each particle's unbalanced force into its deformable's."""
+    i = wp.tid()
+    wp.atomic_add(out_component_residual, particle_component[i], particle_residual[i])
+
+
+@wp.kernel(enable_backward=False)
+def _vbd_scatter_realized_proxy_wrenches_kernel(
+    body_local_to_proxy_global: wp.array[int],
+    realized_body_f: wp.array[wp.spatial_vector],
+    scale: float,
+    out_body_f: wp.array[wp.spatial_vector],
+):
+    """Add each proxy body's realized soft-contact reaction, its mean over the coupled step's substeps, to its wrench."""
+    body_idx = wp.tid()
+    proxy_global = body_local_to_proxy_global[body_idx]
+    if proxy_global < 0 or proxy_global >= out_body_f.shape[0] or body_idx >= realized_body_f.shape[0]:
+        return
+    wp.atomic_add(out_body_f, proxy_global, realized_body_f[body_idx] * scale)
